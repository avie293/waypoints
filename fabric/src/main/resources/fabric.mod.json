{
	"schemaVersion": 1,
	"id": "avies-waypoints",
	"version": "${version}",
	"name": "Avies Waypoints",
	"description": "Set waypoints in your world and find your way back to them.",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_sources}",
		"issues": "${mod_issues}"
	},
	"license": "${mod_license}",
	"icon": "assets/avies-waypoints/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"cc.avie.waypoints.fabric.AviesWaypointsFabric"
		]
	},
	"mixins": [
		"avies-waypoints.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"tabbylib": ">=${tabbylib_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"avie.discord": "https://discord.gg/57TZ8BJvd9"
			}
		}
	}
}
